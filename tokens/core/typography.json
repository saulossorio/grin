{
  "$description": "Uma família para toda a interface (Geist) e uma monoespaçada para códigos, identificadores e números alinhados (Geist Mono). As duas estão em assets/fonts (licença SIL OFL). Tamanhos em rem: a pessoa escolhe 100%, 112,5% ou 125% e tudo acompanha.",
  "font": {
    "family": {
      "sans": {
        "$value": "'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
      },
      "mono": {
        "$value": "'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace"
      }
    },
    "size": {
      "2xs": {
        "$value": "0.625rem",
        "$description": "10 px. Contador sobre ícone na barra recolhida."
      },
      "xs": {
        "$value": "0.75rem",
        "$description": "12 px. Sobretítulo, etiqueta, tecla, contador."
      },
      "sm": {
        "$value": "0.875rem",
        "$description": "14 px. Rótulo de campo, dica, cabeçalho de tabela, texto da densidade compacta."
      },
      "base": {
        "$value": "1rem",
        "$description": "16 px. Texto, botões e campos (padrão)."
      },
      "lg": {
        "$value": "1.125rem",
        "$description": "18 px. Título de cartão e de subseção (h3), descrição da página."
      },
      "xl": {
        "$value": "1.25rem",
        "$description": "20 px. Título de diálogo e de gaveta."
      },
      "2xl": {
        "$value": "1.5rem",
        "$description": "24 px. Título de seção (h2)."
      },
      "3xl": {
        "$value": "2rem",
        "$description": "32 px. Título da página (h1)."
      },
      "4xl": {
        "$value": "2.5rem",
        "$description": "40 px. Número em destaque do indicador."
      }
    },
    "weight": {
      "regular": {
        "$value": "400",
        "$description": "Texto."
      },
      "medium": {
        "$value": "500",
        "$description": "Botões, rótulos, itens de navegação."
      },
      "semibold": {
        "$value": "600",
        "$description": "Títulos e números em destaque."
      },
      "bold": {
        "$value": "700",
        "$description": "Raramente: logotipo e contadores."
      }
    },
    "tracking": {
      "display": {
        "$value": "-0.025em",
        "$description": "Títulos de 24 px para cima."
      },
      "tight": {
        "$value": "-0.011em",
        "$description": "Títulos de 16 a 20 px."
      },
      "normal": {
        "$value": "0"
      },
      "caps": {
        "$value": "0.05em",
        "$description": "Rótulos em maiúsculas."
      }
    },
    "line-height": {
      "tight": {
        "$value": "1.2",
        "$description": "Títulos."
      },
      "ui": {
        "$value": "1.45",
        "$description": "Interface."
      },
      "body": {
        "$value": "1.6",
        "$description": "Texto corrido."
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$value": "140ms",
        "$description": "Hover, troca de cor, toque em botão."
      },
      "base": {
        "$value": "220ms",
        "$description": "Menus, toasts, diálogos, casinha de marcar."
      },
      "slow": {
        "$value": "320ms",
        "$description": "Gaveta e indicadores que deslizam (aba, item de navegação)."
      }
    },
    "easing": {
      "out": {
        "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)",
        "$description": "Entradas: começa rápido e assenta."
      },
      "in-out": {
        "$value": "cubic-bezier(0.4, 0, 0.2, 1)",
        "$description": "Mudanças de tamanho ou posição."
      },
      "spring": {
        "$value": "cubic-bezier(0.34, 1.4, 0.64, 1)",
        "$description": "Indicadores que deslizam e elementos que aparecem: passa um pouco do ponto e volta."
      }
    }
  }
}
