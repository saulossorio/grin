{
  "$description": "Uma família para tudo (Public Sans) e uma monoespaçada para códigos e identificadores. Tamanhos em rem; a pessoa escolhe 100%, 112,5% ou 125%.",
  "font": {
    "family": {
      "sans": { "$value": "'Public Sans', system-ui, -apple-system, 'Segoe UI', sans-serif" },
      "mono": { "$value": "'JetBrains Mono', ui-monospace, monospace" }
    },
    "size": {
      "2xs": { "$value": "0.625rem", "$description": "10 px. Contador sobre ícone recolhido." },
      "xs":  { "$value": "0.6875rem", "$description": "11 px. Selo pequeno, dica de atalho." },
      "sm":  { "$value": "0.75rem", "$description": "12 px. Selos, cabeçalho de tabela, legendas." },
      "md":  { "$value": "0.8125rem", "$description": "13 px. Botões, campos, menus (densidade compacta)." },
      "base":{ "$value": "0.875rem", "$description": "14 px. Texto de interface e células." },
      "body":{ "$value": "1rem", "$description": "16 px. Texto corrido; abaixo disso, só texto secundário." },
      "lg":  { "$value": "1.125rem", "$description": "18 px. Número em destaque." },
      "xl":  { "$value": "1.25rem", "$description": "20 px. Título de diálogo e gaveta." },
      "2xl": { "$value": "1.375rem", "$description": "22 px. Título da página (h1)." },
      "3xl": { "$value": "2rem", "$description": "32 px. Título de página de apresentação." }
    },
    "weight": {
      "regular": { "$value": "400" }, "medium": { "$value": "500" }, "semibold": { "$value": "600" },
      "title": { "$value": "650", "$description": "Títulos h1 e h2." }, "bold": { "$value": "700" }
    },
    "tracking": {
      "tight": { "$value": "-0.015em", "$description": "Títulos." },
      "caps": { "$value": "0.06em", "$description": "Rótulos em maiúsculas." }
    },
    "line-height": { "tight": { "$value": "1.25" }, "ui": { "$value": "1.4" }, "body": { "$value": "1.5" } }
  },
  "motion": {
    "duration": { "base": { "$value": "160ms" }, "slow": { "$value": "200ms" } },
    "easing": { "out": { "$value": "cubic-bezier(.22, .8, .3, 1)" } }
  }
}
