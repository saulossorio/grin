  "primary": "{color.brand.green-400}", "primary-foreground": "{color.neutral.900}", "primary-hover": "{color.brand.green-450}", "link": "{color.brand.green-400}",
  "overlay": "oklch(0.05 0.01 210 / 0.6)", "hover": "oklch(1 0 0 / 0.07)", "highlight": "{color.brand.green-dark-300}",
