  "info-fg": "{color.blue.fg-dark}", "info-bg": "{color.blue.bg-dark}", "info-border": "{color.blue.bd-dark}",
  "ok-fg": "{color.teal.fg-dark}", "ok-bg": "{color.teal.bg-dark}", "ok-border": "{color.teal.bd-dark}",
  "chart-1": "{color.brand.green-500}", "chart-2": "{color.blue.chart-dark}", "chart-band": "oklch(0.36 0.06 130)", "chart-grid": "{color.slate.775}",
