{
  "$description": "Tokens semânticos: o que cada cor significa. São os únicos que os componentes usam. Os valores aqui são os do tema claro; os temas em tokens/themes trocam só os valores.",
  "background":         { "$value": "{color.neutral.0}",   "$description": "Fundo da tela e das tabelas." },
  "foreground":         { "$value": "{color.neutral.900}", "$description": "Texto principal (15,9:1)." },
  "surface":            { "$value": "{color.neutral.0}",   "$description": "Painéis e cartões que precisam se separar do fundo." },
  "popover":            { "$value": "{color.neutral.0}",   "$description": "Diálogos, menus, toasts, popovers." },
  "muted":              { "$value": "{color.neutral.75}",  "$description": "Fundo discreto: selo neutro, aviso neutro, controle segmentado." },
  "muted-foreground":   { "$value": "{color.neutral.700}", "$description": "Texto secundário (8,0:1)." },
  "accent":             { "$value": "{color.neutral.100}", "$description": "Hover de botão e item de menu." },
  "border":             { "$value": "{color.neutral.200}", "$description": "Borda padrão de cartões e divisórias." },
  "border-soft":        { "$value": "{color.neutral.150}", "$description": "Linha entre linhas de tabela, grade de gráfico." },
  "border-strong":      { "$value": "{color.neutral.300}", "$description": "Borda de botão e de camadas flutuantes." },
  "input":              { "$value": "{color.neutral.500}", "$description": "Borda de campo (3:1 contra o fundo)." },
  "field":              { "$value": "{color.neutral.0}",   "$description": "Fundo de campo." },
  "ring":               { "$value": "{color.brand.green-600}", "$description": "Anel de foco." },
  "primary":            { "$value": "{color.brand.green-400}", "$description": "Preenchimento de marca: botão primário, item ativo, barra do topo." },
  "primary-foreground": { "$value": "{color.neutral.900}", "$description": "Texto sobre a marca (7,8:1)." },
  "primary-hover":      { "$value": "{color.brand.green-450}", "$description": "Botão primário com o ponteiro em cima." },
  "link":               { "$value": "{color.brand.green-700}", "$description": "Link e texto de marca (5,0:1)." },
  "overlay":            { "$value": "oklch(0.2 0.01 210 / 0.28)", "$description": "Véu atrás de diálogo e gaveta." },
  "hover":              { "$value": "oklch(0.2 0.01 210 / 0.06)", "$description": "Camada de hover sobre qualquer fundo." },
  "highlight":          { "$value": "oklch(0.92 0.08 128)", "$description": "Seleção de texto e termo encontrado na busca." },
  "row-hover":          { "$value": "{color.neutral.40}", "$description": "Linha de tabela com o ponteiro em cima." },
  "row-selected":       { "$value": "{color.neutral.60}", "$description": "Linha selecionada ou aberta." },
  "table-head":         { "$value": "{color.neutral.25}", "$description": "Cabeçalho fixo da tabela." },
  "sidebar":            { "$value": "{color.neutral.50}", "$description": "Fundo da barra lateral." },
  "sidebar-foreground": { "$value": "oklch(0.32 0.012 200)", "$description": "Texto da navegação." },
  "sidebar-active":     { "$value": "{color.brand.green-100}", "$description": "Item de navegação atual." },
  "brand-fg":           { "$value": "{color.brand.green-700}", "$description": "Texto de chip e etiqueta de marca." },
  "brand-bg":           { "$value": "{color.brand.green-50}",  "$description": "Fundo de chip de filtro ativo e opção marcada." },
  "brand-border":       { "$value": "{color.brand.green-200}", "$description": "Borda de chip e etiqueta de marca." },
  "crit-fg":    { "$value": "{color.red.fg}",    "$description": "Crítico: texto e ícone (6,5:1)." },
  "crit-bg":    { "$value": "{color.red.bg}",    "$description": "Crítico: fundo." },
  "crit-border":{ "$value": "{color.red.bd}",    "$description": "Crítico: borda." },
  "crit-solid": { "$value": "{color.red.solid}", "$description": "Crítico: preenchimento (botão de excluir, contador)." },
  "crit-on":    { "$value": "oklch(0.99 0 0)",   "$description": "Texto sobre crítico sólido." },
  "warn-fg":    { "$value": "{color.amber.fg}",  "$description": "Atenção: texto e ícone (5,0:1)." },
  "warn-bg":    { "$value": "{color.amber.bg}",  "$description": "Atenção: fundo." },
  "warn-border":{ "$value": "{color.amber.bd}",  "$description": "Atenção: borda." },
  "warn-solid": { "$value": "{color.amber.solid}", "$description": "Atenção: ponto de estado." },
  "info-fg":    { "$value": "{color.blue.fg}",   "$description": "Informação: texto e ícone (6,7:1)." },
  "info-bg":    { "$value": "{color.blue.bg}",   "$description": "Informação: fundo." },
  "info-border":{ "$value": "{color.blue.bd}",   "$description": "Informação: borda." },
  "ok-fg":      { "$value": "{color.teal.fg}",   "$description": "Sucesso: texto e ícone (5,5:1). Não é o verde da marca." },
  "ok-bg":      { "$value": "{color.teal.bg}",   "$description": "Sucesso: fundo." },
  "ok-border":  { "$value": "{color.teal.bd}",   "$description": "Sucesso: borda." },
  "chart-1":    { "$value": "{color.brand.green-700}", "$description": "Gráfico: série principal (o modelo)." },
  "chart-2":    { "$value": "{color.blue.chart}", "$description": "Gráfico: série de comparação (o real). Sempre com rótulo." },
  "chart-band": { "$value": "{color.brand.green-150}", "$description": "Gráfico: faixa de intervalo." },
  "chart-grid": { "$value": "{color.neutral.150}", "$description": "Gráfico: linhas de grade." },
  "shadow-sm":  { "$value": "0 1px 2px oklch(0.2 0.01 210 / 0.08)", "$description": "Botão marcado, controle segmentado." },
  "shadow-lg":  { "$value": "0 16px 48px oklch(0.2 0.01 210 / 0.16), 0 2px 6px oklch(0.2 0.01 210 / 0.08)", "$description": "Camadas flutuantes." }
}
